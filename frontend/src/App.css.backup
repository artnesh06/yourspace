/* ════════════════════════════════════════════════════════════════
   YOUR SPACE — premium redesign
   warm cream canvas · ink typography · ember accent
   ════════════════════════════════════════════════════════════════ */

.app {
  display: flex;
  height: 100svh;
  background: var(--canvas);
}

/* ════════════ SIDEBAR ════════════ */

.sidebar-v2 {
  width: 60px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 0 16px;
  background: transparent;
  border-right: 1px solid var(--line);
}

.sb-logo {
  width: 36px; height: 36px;
  display: grid; place-items: center;
  border-radius: 11px;
  background: var(--ink);
  margin-bottom: 18px;
  box-shadow: var(--shadow-sm);
}
.sb-logo svg { stroke: #F5F0E8 !important; }

.sb-icons-top {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sb-icons-bottom {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.sb-icon {
  width: 38px; height: 38px;
  display: grid; place-items: center;
  border-radius: 10px;
  color: var(--ink-3);
  position: relative;
  transition: color .15s, background .15s;
}
.sb-icon:hover { color: var(--ink); background: rgba(28,27,24,0.05); }
.sb-icon.active {
  color: var(--ink);
  background: var(--surface);
  box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
}
.sb-icon.active::before {
  content: '';
  position: absolute;
  left: -11px; top: 50%;
  transform: translateY(-50%);
  width: 3px; height: 18px;
  border-radius: 0 3px 3px 0;
  background: var(--accent);
}

.sb-avatar {
  width: 32px; height: 32px;
  margin-top: 8px;
  display: grid; place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8542F, #C43E1F);
  color: #fff;
  font-size: 12.5px;
  font-weight: 700;
  box-shadow: var(--shadow-sm), 0 0 0 2px var(--canvas), 0 0 0 3.5px var(--line-2);
}

/* ════════════ MAIN ════════════ */

.main-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* ── Topbar ── */

.topbar-v2 {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px 10px;
}

.topbar-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.topbar-tabs::-webkit-scrollbar { display: none; }

.board-tab {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 550;
  color: var(--ink-3);
  white-space: nowrap;
  transition: color .15s, background .15s, box-shadow .15s;
}
.board-tab:hover { color: var(--ink-2); background: rgba(28,27,24,0.04); }
.board-tab.active {
  color: var(--ink);
  font-weight: 650;
  background: var(--surface);
  box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
}
.board-tab-icon { font-size: 12px; line-height: 1; }

.tab-add-btn {
  width: 28px; height: 28px;
  display: grid; place-items: center;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  color: var(--ink-4);
  transition: color .15s, background .15s;
}
.tab-add-btn:hover { color: var(--ink); background: rgba(28,27,24,0.05); }

.tab-add-form input {
  width: 130px;
  padding: 6px 10px;
  font-size: 13px;
  border: 1px solid var(--line-2);
  border-radius: 9px;
  background: var(--surface);
  outline: none;
}
.tab-add-form input:focus { border-color: var(--ink-4); }

.topbar-spacer { flex: 1; }

.topbar-search-input {
  width: 210px;
  padding: 7px 12px;
  font-size: 13px;
  border: 1px solid var(--line-2);
  border-radius: 10px;
  background: var(--surface);
  outline: none;
  box-shadow: var(--shadow-sm);
  animation: fadeIn .15s ease;
}
.topbar-search-input:focus { border-color: var(--ink-4); }

.topbar-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 13px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 550;
  color: var(--ink-2);
  background: var(--surface);
  box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.topbar-btn:hover {
  color: var(--ink);
  box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line-2);
  transform: translateY(-1px);
}
.topbar-btn.active {
  color: var(--ink);
  box-shadow: inset 0 0 0 1.5px var(--ink);
}
.topbar-btn.primary {
  color: #FFF8F2;
  background: var(--ink);
  box-shadow: var(--shadow-md);
}
.topbar-btn.primary:hover {
  background: #2A2925;
  transform: translateY(-1px);
  box-shadow: var(--shadow-lg);
}

/* ── Filter bar ── */

.filter-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 22px 10px;
  animation: fadeUp .18s ease;
}
.filter-label {
  font-size: 11px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--ink-3);
  margin-right: 4px;
}
.filter-chip {
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 550;
  color: var(--ink-2);
  background: var(--surface);
  box-shadow: inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.filter-chip:hover { box-shadow: inset 0 0 0 1px var(--line-2); transform: translateY(-1px); }
.filter-chip.active {
  color: #FFF8F2;
  background: var(--ink);
  box-shadow: none;
}

/* ════════════ BOARD ════════════ */

.board-frame-wrap {
  flex: 1;
  min-height: 0;
  padding: 2px 20px 20px;
  display: flex;
}

.board-frame {
  flex: 1;
  min-width: 0;
  display: flex;
  border-radius: 18px;
  background: var(--canvas-deep);
  border: 1px solid var(--line-2);
  overflow: hidden;
}

.board-row { flex: 1; min-width: 0; display: flex; }
.board-dnd-wrapper { flex: 1; min-width: 0; display: flex; }

.board-container {
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 16px;
}

.board {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  height: 100%;
}

/* ── Column ── */

.column {
  width: 290px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  max-height: 100%;
  border-radius: var(--radius);
  background: rgba(255,255,255,0.55);
  box-shadow: inset 0 0 0 1px rgba(230,228,220,0.9);
  backdrop-filter: blur(4px);
}

.column-sticky {
  padding: 12px 12px 0;
}

.column-header {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 2px 2px 10px;
}

.column-drag-handle {
  display: grid;
  place-items: center;
  width: 20px; height: 20px;
  border-radius: 6px;
  cursor: grab;
  color: var(--ink-4);
  transition: background .15s;
}
.column-drag-handle:hover { background: rgba(28,27,24,0.06); }
.column-drag-handle:active { cursor: grabbing; }

.column-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--ink-2);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.column-count {
  min-width: 22px;
  height: 20px;
  padding: 0 7px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink-2);
  background: var(--surface);
  box-shadow: inset 0 0 0 1px var(--line);
}

.column-menu-btn {
  width: 24px; height: 24px;
  display: grid; place-items: center;
  border-radius: 7px;
  color: var(--ink-4);
  transition: color .15s, background .15s;
}
.column-menu-btn:hover { color: var(--ink); background: rgba(28,27,24,0.06); }

.add-card-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  font-weight: 550;
  color: var(--ink-3);
  border: 1.5px dashed var(--line-2);
  transition: all .15s;
}
.add-card-btn:hover {
  color: var(--accent-text);
  border-color: var(--accent);
  background: var(--accent-soft);
}

.column-cards {
  flex: 1;
  min-height: 60px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 10px 12px 12px;
  border-radius: 0 0 var(--radius) var(--radius);
  transition: background .15s;
}

.empty-col {
  display: grid;
  place-items: center;
  padding: 28px 10px;
  border-radius: var(--radius-sm);
  border: 1.5px dashed var(--line-2);
  font-size: 12.5px;
  color: var(--ink-4);
}

/* ── Card ── */

.card {
  position: relative;
  border-radius: var(--radius-sm);
  background: var(--surface);
  box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
  transition: box-shadow .18s, transform .18s;
  animation: fadeUp .2s ease;
}
.card:hover {
  box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line-2);
  transform: translateY(-2px);
}

.card-body { padding: 13px 14px 12px; }

.card-cover {
  position: relative;
  margin: -13px -14px 10px;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  overflow: hidden;
  height: 120px;
}
.card-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
.card-cover-count {
  position: absolute;
  right: 8px; bottom: 8px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 650;
  color: #fff;
  background: rgba(28,27,24,0.65);
  backdrop-filter: blur(4px);
}

.card-title {
  font-size: 13.5px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.012em;
  color: var(--ink);
  padding-right: 22px;
}

.card-excerpt {
  margin-top: 5px;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--ink-3);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 11px;
}

.card-date {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3.5px 9px;
  border-radius: 7px;
  font-size: 11.5px;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.card-date.pink   { background: var(--pink-light);   color: var(--pink-text); }
.card-date.green  { background: var(--green-light);  color: var(--green-text); }
.card-date.blue   { background: var(--blue-light);   color: var(--blue-text); }
.card-date.yellow { background: var(--yellow-light); color: var(--yellow-text); }
.card-date.purple { background: var(--purple-light); color: var(--purple-text); }

.card-comment-count {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ink-3);
}

.card-done .card-title {
  text-decoration: line-through;
  color: var(--ink-3);
}
.card-done { opacity: .75; }

.card-menu-btn {
  position: absolute;
  top: 9px; right: 9px;
  width: 24px; height: 22px;
  display: grid; place-items: center;
  border-radius: 6px;
  font-size: 10px;
  letter-spacing: 1px;
  color: var(--ink-4);
  opacity: 0;
  transition: opacity .15s, background .15s, color .15s;
  z-index: 2;
}
.card:hover .card-menu-btn { opacity: 1; }
.card-menu-btn:hover { color: var(--ink); background: rgba(28,27,24,0.06); }

/* ── Dropdowns ── */

.column-dropdown,
.card-dropdown-portal {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  min-width: 160px;
  padding: 5px;
  border-radius: 12px;
  background: var(--surface);
  box-shadow: var(--shadow-lg), inset 0 0 0 1px var(--line);
  z-index: 100;
  animation: fadeUp .14s ease;
}
.card-dropdown-portal { position: fixed; top: auto; right: auto; z-index: 1000; }

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  padding: 8px 10px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-2);
  text-align: left;
  transition: background .12s, color .12s;
}
.dropdown-item:hover { background: var(--canvas); color: var(--ink); }
.dropdown-item.danger { color: var(--accent-text); }
.dropdown-item.danger:hover { background: var(--accent-soft); }

.dropdown-sep {
  height: 1px;
  margin: 4px 6px;
  background: var(--line);
}

/* ── Forms ── */

.add-card-form,
.add-column-form {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  border-radius: var(--radius-sm);
  background: var(--surface);
  box-shadow: var(--shadow-md), inset 0 0 0 1px var(--line);
  animation: fadeUp .15s ease;
}

.add-card-form input,
.add-column-form input {
  padding: 8px 11px;
  font-size: 13px;
  border: 1px solid var(--line-2);
  border-radius: 9px;
  background: var(--surface-2);
  outline: none;
  transition: border-color .15s, box-shadow .15s;
}
.add-card-form input:focus,
.add-column-form input:focus {
  border-color: var(--ink-4);
  box-shadow: 0 0 0 3px rgba(28,27,24,0.05);
  background: var(--surface);
}

.add-card-form-actions,
.add-column-actions {
  display: flex;
  gap: 6px;
}

.btn-primary {
  padding: 7px 16px;
  border-radius: 9px;
  font-size: 12.5px;
  font-weight: 650;
  color: #FFF8F2;
  background: var(--ink);
  transition: background .15s, transform .15s;
}
.btn-primary:hover { background: #2A2925; transform: translateY(-1px); }

.btn-ghost {
  padding: 7px 14px;
  border-radius: 9px;
  font-size: 12.5px;
  font-weight: 550;
  color: var(--ink-3);
  transition: color .15s, background .15s;
}
.btn-ghost:hover { color: var(--ink); background: rgba(28,27,24,0.05); }

/* ── Add column ── */

.add-column-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 150px;
  padding: 26px 16px;
  border-radius: var(--radius);
  border: 1.5px dashed var(--line-2);
  color: var(--ink-3);
  transition: all .18s;
}
.add-column-btn svg { stroke: var(--ink-4) !important; transition: stroke .18s; }
.add-column-btn:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent-text);
}
.add-column-btn:hover svg { stroke: var(--accent) !important; }
.add-column-label { font-size: 12.5px; font-weight: 600; }

.add-column-form { width: 250px; flex-shrink: 0; }

/* ════════════ CHAT PANEL ════════════ */

.chat-panel-wrapper {
  flex-shrink: 0;
  width: 0;
  overflow: hidden;
  transition: width .3s cubic-bezier(.32,.72,.32,1);
}
.chat-panel-wrapper.open { width: 380px; }

.chat-panel-backdrop { display: none; }

.chat-panel {
  width: 380px;
  height: calc(100% - 30px);
  margin: 10px 10px 20px 0;
  border-radius: 18px;
  background: #FFFFFF;
  overflow: hidden;
  box-shadow: none;
}

@media (max-width: 900px) {
  .chat-panel-wrapper { position: fixed; inset: 0 0 0 auto; width: 0; z-index: 200; }
  .chat-panel-wrapper.open { width: min(380px, 100vw); }
  .chat-panel { height: calc(100% - 20px); margin: 10px 10px 10px 0; box-shadow: none; }
}

.chat-panel-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
}
.chat-header-left { display: flex; align-items: center; gap: 8px; }
.chat-header-title { font-size: 14px; font-weight: 700; letter-spacing: -0.015em; color: var(--ink); }
.chat-header-badge {
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 750;
  letter-spacing: .05em;
  color: var(--accent-text);
  background: var(--accent-soft);
}
.chat-header-actions { display: flex; gap: 4px; }
.chat-header-btn {
  width: 28px; height: 28px;
  display: grid; place-items: center;
  border-radius: 8px;
  color: var(--ink-3);
  transition: color .15s, background .15s;
}
.chat-header-btn:hover { color: var(--ink); background: var(--canvas-deep); }

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.chat-welcome {
  text-align: center;
  padding: 36px 12px 16px;
  animation: fadeUp .25s ease;
}
.chat-welcome-icon {
  width: 44px; height: 44px;
  margin: 0 auto 14px;
  display: grid; place-items: center;
  border-radius: 14px;
  font-size: 20px;
  color: var(--accent);
  background: var(--accent-soft);
}
.chat-welcome-title {
  font-size: 16.5px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.chat-welcome-sub {
  margin-top: 5px;
  font-size: 13px;
  color: var(--ink-3);
}
.chat-suggestions {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 18px;
}
.chat-suggestion {
  padding: 10px 13px;
  border-radius: 11px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-2);
  text-align: left;
  background: var(--canvas-deep);
  border: 1px solid var(--line);
  transition: all .15s;
}
.chat-suggestion:hover {
  color: var(--ink);
  border-color: var(--line-2);
  transform: translateY(-1px);
}

.chat-msg { display: flex; }
.chat-msg--user { justify-content: flex-end; }
.chat-msg--assistant { justify-content: flex-start; }

.chat-msg-bubble {
  max-width: 85%;
  padding: 10px 14px;
  border-radius: 16px;
  font-size: 13.5px;
  line-height: 1.55;
  animation: fadeUp .18s ease;
}
.chat-msg--user .chat-msg-bubble {
  color: #fff;
  background: var(--ink);
  border-bottom-right-radius: 6px;
}
.chat-msg--assistant .chat-msg-bubble {
  color: var(--ink);
  background: var(--canvas-deep);
  border: 1px solid var(--line);
  border-bottom-left-radius: 6px;
}

.chat-tool-events {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 7px;
}
.tool-badge {
  padding: 2.5px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 650;
  color: var(--green-text);
  background: var(--green-light);
}

.chat-empty { color: var(--ink-4); }

/* ── Markdown content ── */
.md-content { display: flex; flex-direction: column; gap: 6px; }
.md-content .md-p { margin: 0; line-height: 1.6; }
.md-content .md-p:empty { display: none; }
.md-content .md-h1 { font-size: 16px; font-weight: 800; letter-spacing: -0.02em; margin: 4px 0 2px; }
.md-content .md-h2 { font-size: 14px; font-weight: 750; margin: 4px 0 2px; }
.md-content .md-h3 { font-size: 13px; font-weight: 700; margin: 2px 0; }
.md-content strong { font-weight: 750; color: inherit; }
.md-content em { font-style: italic; }
.md-content .md-ul, .md-content .md-ol {
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 2px 0;
}
.md-content .md-ul li { list-style: disc; }
.md-content .md-ol li { list-style: decimal; }
.md-content li { line-height: 1.55; font-size: 13.5px; }
.md-content .md-code {
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 5px;
  background: var(--canvas-deep);
  border: 1px solid var(--line);
}
.chat-msg--user .md-content .md-code { background: rgba(255,255,255,0.15); border-color: transparent; }
.md-content .md-pre {
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(28,27,24,0.06);
  overflow-x: auto;
  margin: 2px 0;
  line-height: 1.5;
}
.md-content .md-blockquote {
  border-left: 3px solid var(--line-2);
  padding-left: 10px;
  color: var(--ink-3);
  margin: 2px 0;
  font-style: italic;
}
.md-content .md-hr {
  border: none;
  border-top: 1px solid var(--line);
  margin: 4px 0;
}
.md-content .md-link {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
  word-break: break-all;
}
.md-content .md-link:hover { opacity: 0.8; }
.chat-msg--user .md-content .md-link { color: rgba(255,255,255,0.85); }

.chat-cursor {
  display: inline-block;
  width: 7px; height: 14px;
  margin-left: 2px;
  vertical-align: text-bottom;
  background: var(--accent);
  border-radius: 2px;
  animation: blink 1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.chat-msg-meta {
  margin-top: 6px;
  font-size: 10.5px;
  font-weight: 550;
  color: var(--ink-4);
  font-variant-numeric: tabular-nums;
}

.chat-typing { display: inline-flex; gap: 4px; padding: 3px 0; }
.chat-typing span {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--ink-4);
  animation: typing 1.2s ease-in-out infinite;
}
.chat-typing span:nth-child(2) { animation-delay: .15s; }
.chat-typing span:nth-child(3) { animation-delay: .3s; }
@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); opacity: .5; }
  30% { transform: translateY(-4px); opacity: 1; }
}

/* ── Chat input ── */

.chat-input-area {
  padding: 12px 14px 14px;
  border-top: 1px solid var(--line);
}

.chat-token-bar-wrap { margin-bottom: 10px; }
.chat-token-bar-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4px;
}
.chat-token-bar-label {
  font-size: 10.5px;
  font-weight: 550;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.chat-token-bar-pct { font-size: 10.5px; font-weight: 700; font-variant-numeric: tabular-nums; }
.chat-token-bar {
  height: 3px;
  border-radius: 4px;
  background: var(--line);
  overflow: hidden;
}
.chat-token-bar-fill {
  height: 100%;
  border-radius: 4px;
  transition: width .4s ease;
}
.chat-token-bar-fill.low    { background: var(--green); }
.chat-token-bar-fill.medium { background: #D9A514; }
.chat-token-bar-fill.high   { background: var(--accent); }

.chat-model-row { margin-bottom: 8px; }
.chat-model-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ink-2);
  background: var(--canvas-deep);
  border: 1px solid var(--line);
  transition: all .15s;
}
.chat-model-btn:hover { color: var(--ink); border-color: var(--line-2); }

.chat-input-form {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  padding: 4px 4px 4px 14px;
  border-radius: 14px;
  background: var(--canvas-deep);
  border: 1px solid var(--line);
  transition: border-color .15s;
}
.chat-input-form:focus-within {
  border-color: var(--ink-4);
}

.chat-input {
  flex: 1;
  resize: none;
  border: none;
  background: none;
  outline: none;
  padding: 9px 0;
  font-size: 13.5px;
  line-height: 1.5;
  max-height: 120px;
  color: var(--ink);
}
.chat-input::placeholder { color: var(--ink-4); }

.chat-send-btn,
.chat-stop-btn {
  width: 34px; height: 34px;
  flex-shrink: 0;
  display: grid; place-items: center;
  border-radius: 11px;
  margin-bottom: 1px;
  color: #FFF8F2;
  background: var(--ink);
  transition: background .15s, transform .15s, opacity .15s;
}
.chat-send-btn:hover, .chat-stop-btn:hover { background: #2A2925; transform: translateY(-1px); }
.chat-send-btn:disabled { opacity: .35; cursor: default; transform: none; }
.chat-stop-btn { background: var(--accent); }
.chat-stop-btn:hover { background: var(--accent-deep); }

/* ── Model picker ── */

.model-picker-overlay {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28,27,24,0.18);
  backdrop-filter: blur(2px);
  animation: fadeIn .15s ease;
}

.model-picker {
  width: min(400px, 90vw);
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  border-radius: 18px;
  background: var(--surface);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-xl);
  animation: fadeUp .2s ease;
  overflow: hidden;
}

.model-picker-search-wrap { padding: 12px 12px 8px; }
.model-picker-search {
  width: 100%;
  padding: 9px 13px;
  font-size: 13px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--canvas-deep);
  outline: none;
  color: var(--ink);
}
.model-picker-search::placeholder { color: var(--ink-4); }
.model-picker-search:focus { border-color: var(--ink-4); background: var(--surface); }

.model-picker-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 8px 12px;
}

.model-picker-loading {
  padding: 24px;
  text-align: center;
  font-size: 13px;
  color: var(--ink-3);
}

.model-group-header {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 12px 8px 6px;
  font-size: 11px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--ink-3);
}
.model-group-icon { font-size: 12px; }
.model-group-count {
  margin-left: auto;
  font-weight: 600;
  color: var(--ink-4);
}

.model-item {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 9px 10px;
  border-radius: 9px;
  font-size: 13px;
  color: var(--ink-2);
  text-align: left;
  transition: background .12s;
}
.model-item:hover { background: var(--canvas-deep); color: var(--ink); }
.model-item.active {
  color: var(--ink);
  font-weight: 650;
  background: var(--accent-soft);
}
.model-item-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--green);
  flex-shrink: 0;
}

/* ════════════ CARD MODAL ════════════ */

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28px;
  background: rgba(28,27,24,0.32);
  backdrop-filter: blur(4px);
  animation: fadeIn .18s ease;
}

.detail-modal {
  position: relative;
  display: flex;
  width: min(880px, 100%);
  max-height: min(640px, 100%);
  border-radius: 20px;
  background: var(--surface);
  box-shadow: var(--shadow-xl);
  overflow: hidden;
  animation: fadeUp .22s cubic-bezier(.32,.72,.32,1);
}

.detail-modal-left {
  flex: 1.6;
  min-width: 0;
  overflow-y: auto;
  padding: 26px 26px 22px;
}

.detail-modal-right {
  flex: 1;
  min-width: 250px;
  display: flex;
  flex-direction: column;
  border-left: 1px solid var(--line);
  background: var(--surface-2);
}

.detail-modal-close {
  position: absolute;
  top: 14px; right: 14px;
  width: 30px; height: 30px;
  display: grid; place-items: center;
  border-radius: 9px;
  font-size: 18px;
  color: var(--ink-3);
  background: var(--surface);
  box-shadow: inset 0 0 0 1px var(--line);
  z-index: 5;
  transition: all .15s;
}
.detail-modal-close:hover { color: var(--ink); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line-2); }

.detail-title-wrap { margin-bottom: 12px; padding-right: 28px; }
.detail-title-input {
  width: 100%;
  font-size: 19px;
  font-weight: 700;
  letter-spacing: -0.022em;
  color: var(--ink);
  border: none;
  outline: none;
  background: none;
  padding: 2px 0;
  border-bottom: 1.5px solid transparent;
  transition: border-color .15s;
}
.detail-title-input:focus { border-bottom-color: var(--line-2); }

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 22px;
}

.detail-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 11px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 650;
}
.detail-chip-col {
  color: var(--ink-2);
  background: var(--canvas);
  box-shadow: inset 0 0 0 1px var(--line);
}
.detail-chip-date.pink   { background: var(--pink-light);   color: var(--pink-text); }
.detail-chip-date.green  { background: var(--green-light);  color: var(--green-text); }
.detail-chip-date.blue   { background: var(--blue-light);   color: var(--blue-text); }
.detail-chip-date.yellow { background: var(--yellow-light); color: var(--yellow-text); }
.detail-chip-date.purple { background: var(--purple-light); color: var(--purple-text); }

.detail-section-block { margin-bottom: 22px; }
.detail-section-label {
  font-size: 10.5px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: .09em;
  color: var(--ink-3);
  margin-bottom: 9px;
}

/* drop zone & carousel */
.detail-drop-zone {
  position: relative;
  border-radius: var(--radius-sm);
  border: 1.5px dashed var(--line-2);
  overflow: hidden;
  cursor: pointer;
  transition: border-color .15s, background .15s;
}
.detail-drop-zone:not(.has-image):hover,
.detail-drop-zone.drag-over {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.detail-drop-zone.has-image { border-style: solid; border-color: var(--line); cursor: default; }

.drop-zone-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 30px 16px;
  color: var(--ink-4);
}
.drop-zone-empty p { font-size: 13px; font-weight: 600; color: var(--ink-3); }
.drop-zone-empty span { font-size: 11.5px; }

.detail-img-main {
  display: block;
  width: 100%;
  max-height: 240px;
  object-fit: cover;
}

.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 30px; height: 30px;
  display: grid; place-items: center;
  border-radius: 50%;
  font-size: 18px;
  color: var(--ink);
  background: rgba(255,255,255,0.9);
  box-shadow: var(--shadow-md);
  transition: background .15s;
}
.carousel-btn:hover { background: #fff; }
.carousel-prev { left: 10px; }
.carousel-next { right: 10px; }

.carousel-dots {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 5px;
}
.carousel-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.55);
  cursor: pointer;
  transition: background .15s, transform .15s;
}
.carousel-dot.active { background: #fff; transform: scale(1.25); }

.carousel-count {
  position: absolute;
  top: 10px; right: 10px;
  padding: 2px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 650;
  color: #fff;
  background: rgba(28,27,24,0.6);
  backdrop-filter: blur(4px);
}

.detail-img-actions {
  display: flex;
  gap: 6px;
  margin-top: 8px;
}

.detail-action-btn-sm {
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-2);
  background: var(--canvas);
  box-shadow: inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.detail-action-btn-sm:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); }
.detail-action-btn-sm.danger { color: var(--accent-text); }
.detail-action-btn-sm.danger:hover { background: var(--accent-soft); }

/* attachments */
.detail-attachments {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.attachment-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 8px;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  box-shadow: inset 0 0 0 1px var(--line);
}
.attachment-thumb {
  width: 48px; height: 48px;
  border-radius: 8px;
  object-fit: cover;
  flex-shrink: 0;
}
.attachment-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.attachment-name {
  font-size: 12.5px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attachment-date { font-size: 11px; color: var(--ink-4); }
.attachment-actions { display: flex; gap: 5px; flex-shrink: 0; }
.attachment-cover-btn {
  padding: 4px 9px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 650;
  color: var(--ink-3);
  box-shadow: inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.attachment-cover-btn:hover { color: var(--ink); }
.attachment-cover-btn.active {
  color: var(--green-text);
  background: var(--green-light);
  box-shadow: none;
}
.attachment-del-btn {
  width: 26px; height: 26px;
  display: grid; place-items: center;
  border-radius: 7px;
  color: var(--ink-4);
  transition: all .15s;
}
.attachment-del-btn:hover { color: var(--accent-text); background: var(--accent-soft); }

/* description / due */
.detail-desc-area {
  width: 100%;
  min-height: 88px;
  resize: vertical;
  padding: 11px 13px;
  font-size: 13.5px;
  line-height: 1.55;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  outline: none;
  transition: border-color .15s, background .15s;
}
.detail-desc-area:focus { border-color: var(--ink-4); background: var(--surface); }

.detail-due-input {
  width: 160px;
  padding: 8px 12px;
  font-size: 13px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface-2);
  outline: none;
  transition: border-color .15s, background .15s;
}
.detail-due-input:focus { border-color: var(--ink-4); background: var(--surface); }

/* move to column */
.detail-move-cols {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.detail-move-btn {
  padding: 6px 13px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-2);
  box-shadow: inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.detail-move-btn:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); transform: translateY(-1px); }
.detail-move-btn.active {
  color: #FFF8F2;
  background: var(--ink);
  box-shadow: none;
}

/* actions */
.detail-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  padding-top: 6px;
  border-top: 1px solid var(--line);
}
.detail-save-btn {
  padding: 9px 22px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  color: #FFF8F2;
  background: var(--ink);
  box-shadow: var(--shadow-sm);
  transition: background .15s, transform .15s;
}
.detail-save-btn:hover { background: #2A2925; transform: translateY(-1px); }

.detail-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--ink-2);
  box-shadow: inset 0 0 0 1px var(--line);
  transition: all .15s;
}
.detail-action-btn:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); }
.detail-action-btn.danger { color: var(--accent-text); }
.detail-action-btn.danger:hover { background: var(--accent-soft); box-shadow: none; }

/* comments */
.comments-panel-head {
  padding: 20px 18px 12px;
  font-size: 10.5px;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: .09em;
  color: var(--ink-3);
}

.comments-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.no-comments {
  padding: 22px 10px;
  text-align: center;
  font-size: 12.5px;
  color: var(--ink-4);
}

.comment-item {
  position: relative;
  padding: 11px 13px;
  border-radius: var(--radius-sm);
  background: var(--surface);
  box-shadow: inset 0 0 0 1px var(--line);
}
.comment-text {
  font-size: 13px;
  line-height: 1.5;
  padding-right: 18px;
}
.comment-time {
  margin-top: 5px;
  font-size: 10.5px;
  color: var(--ink-4);
}
.comment-delete {
  position: absolute;
  top: 8px; right: 8px;
  width: 20px; height: 20px;
  display: grid; place-items: center;
  border-radius: 6px;
  font-size: 14px;
  color: var(--ink-4);
  opacity: 0;
  transition: all .15s;
}
.comment-item:hover .comment-delete { opacity: 1; }
.comment-delete:hover { color: var(--accent-text); background: var(--accent-soft); }

.comments-input-wrap {
  padding: 12px 14px 14px;
  border-top: 1px solid var(--line);
}
.comments-input-wrap form {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.comments-textarea {
  width: 100%;
  min-height: 60px;
  resize: none;
  padding: 10px 12px;
  font-size: 13px;
  line-height: 1.5;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface);
  outline: none;
  transition: border-color .15s;
}
.comments-textarea:focus { border-color: var(--ink-4); }
.comments-post-btn {
  align-self: flex-end;
  padding: 7px 18px;
  border-radius: 9px;
  font-size: 12.5px;
  font-weight: 650;
  color: #FFF8F2;
  background: var(--ink);
  transition: background .15s, transform .15s;
}
.comments-post-btn:hover { background: #2A2925; transform: translateY(-1px); }

/* ── Responsive ── */
@media (max-width: 760px) {
  .detail-modal { flex-direction: column; max-height: 100%; }
  .detail-modal-right { border-left: none; border-top: 1px solid var(--line); min-width: 0; }
  .chat-panel { width: calc(100vw - 20px); }
}
